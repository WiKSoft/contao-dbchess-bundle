{% block dbchess_list_default %}
<div class="{{ class }} block"{{ cssID|raw }}{% if style %} style="{{ style|raw }}"{% endif %}>

    {% block dbchess_list_default_headline %}
        {% if headline %}
            <{{ hl }}>{{ headline }}</{{ hl }}>
        {% endif %}
    {% endblock %}

    {% block dbchess_list_default_games %}
        {% for game in gameslist %}
            {% block dbchess_list_default_game %}
                <div class="dbChess_list_game block">
                    {% if game.href %}
                        <a href="{{ game.href|raw }}" title="{{ lblPlay }}">
                    {% endif %}
                    {% for key, value in game %}
                        {% if key not in ['id', 'href', 'linkTitle'] %}
                            {% set field = value %}
                            {% if key == 'annotator' and field %}
                                {% set field = '[' ~ field ~ ']' %}
                            {% elseif key == 'round' %}
                                {% set field = '(' ~ field ~ ')' %}
                            {% elseif key == 'sid' and field %}
                                {% set field = '#' ~ field %}
                            {% endif %}
                            <span class="dbChess_list_{{ key }}">{{ field }}</span>
                        {% endif %}
                    {% endfor %}
                    {% if game.href %}
                        </a>
                    {% endif %}
                </div>
            {% endblock %}
        {% endfor %}
    {% endblock %}

</div>
{% endblock %}
